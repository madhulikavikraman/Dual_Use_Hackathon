# Required
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-haiku-5-5
ANALYSIS_MODEL=claude-sonnet-5-5

# Optional: Supabase store (leave empty to use the local file store in .data/)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# auto | local | supabase
STORAGE=auto

# Public URL of this app (a tunnel such as cloudflared, or the deploy), for QR codes and Retell webhooks
APP_BASE_URL=

# Optional: Retell AI phone-network transport (see docs/RETELL.md)
RETELL_API_KEY=
RETELL_FROM_NUMBER=
RETELL_AGENT_ID_EN=
RETELL_AGENT_ID_ES=
RETELL_AGENT_ID_KO=
RETELL_AGENT_ID_ZH=
RETELL_AGENT_ID_HI=
RETELL_AGENT_ID_FR=
RETELL_AGENT_ID_HY=
RETELL_AGENT_ID_TL=

# Optional: text messages for the live-location link (to a resident) and the helper link (to a helper).
# Without these, a send is simulated and labeled (feed + ledger) and the six demo devices get the link on their
# browser phone. Links use APP_BASE_URL (or the request's origin), so set APP_BASE_URL to the https tunnel.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Retell outbound SMS (POST /create-sms-chat), tried before Twilio when RETELL_SMS=1. Needs a Retell chat agent whose
# opening message is exactly {{sms_body}} and a number with SMS enabled (see docs/RETELL.md). Untested; off by default.
RETELL_SMS=
RETELL_SMS_AGENT_ID=
RETELL_SMS_FROM_NUMBER=

# Optional: the six volunteer phones (E.164, e.g. +12135550142) for Retell calls
DEVICE_PHONE_1=
DEVICE_PHONE_2=
DEVICE_PHONE_3=
DEVICE_PHONE_4=
DEVICE_PHONE_5=
DEVICE_PHONE_6=

# Set this before exposing the app through a public tunnel: the board, registry (phone numbers), approvals and
# exports then need HTTP Basic auth (any user name, this password). Phone pages, /call, Retell, feeds, and the two
# links sent by text (/l/<token> for residents, /helper/<token> for helpers) stay open: the token is the key.
DESK_PASSWORD=

# Optional: integrations and call scripts
FEED_TOKEN=demo
ARCGIS_API_KEY=
NASA_FIRMS_MAP_KEY=
CALLBACK_NUMBER=(213) 555-0142
VERIFICATION_PHRASE=blue heron
